{
  "name": "easy-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shixing's bilingual personal journal, powered by Next.js and GitHub App content management.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "content:migrate": "node scripts/migrate-content.mjs",
    "admin:hash": "node scripts/generate-admin-hash.mjs",
    "drafts:publish": "node scripts/publish-drafts.mjs",
    "sync:content": "node scripts/migrate-content.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.525.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
