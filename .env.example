# Public site configuration
NEXT_PUBLIC_SITE_URL=https://tangyingbao.com

# Admin authentication (generate with: npm run admin:hash -- "a-long-password")
ADMIN_PASSWORD_HASH=scrypt$replace-me
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=uudon
GITHUB_REPO=easy-web
GITHUB_BRANCH=main

# Keep false in preview environments. Enable only in production.
ENABLE_CONTENT_WRITES=false
